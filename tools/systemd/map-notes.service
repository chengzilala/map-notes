[Unit]
Description=map-notes (静态页面 + 口令登录 + 备注接口)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/srv/chesterlee/map
EnvironmentFile=/etc/map-notes/secrets.env
ExecStart=/srv/chesterlee/map/.venv/bin/python /srv/chesterlee/map/tools/serve.py --host 127.0.0.1 --port 8931
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
